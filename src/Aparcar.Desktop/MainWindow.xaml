                        <TextBlock Text="Fechas para Concepto 2 (servicios): yyyy-MM-dd"/>
                        <TextBox x:Name="FiscalServicioDesdeInput" Width="230" HorizontalAlignment="Left"
                                 PlaceholderText="Servicio desde"/>
                        <TextBox x:Name="FiscalServicioHastaInput" Width="230" HorizontalAlignment="Left"
                                 PlaceholderText="Servicio hasta"/>
                        <TextBox x:Name="FiscalVencimientoInput" Width="230" HorizontalAlignment="Left"
                                 PlaceholderText="Vencimiento del pago"/>
                        <Button x:Name="FiscalPrepararButton" Content="Validar datos y reservar siguiente número en homologación"
                                Click="FiscalPreparar_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Solicitudes ARCA" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="SOLICITUDES HOMOLOGADAS O POR CONCILIAR" FontWeight="SemiBold"/>
                        <ComboBox x:Name="FiscalSolicitudesCombo" Width="610" HorizontalAlignment="Left"
                                  PlaceholderText="Seleccionar solicitud fiscal"/>
                        <TextBlock Text="Consulta fiscal del EMISOR (homologación)"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Consulta ARCA la razón social y domicilio fiscal del CUIT emisor. El domicilio comercial, IVA e Ingresos Brutos deben revisarse antes de guardar el perfil."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <Button x:Name="FiscalConsultarConstanciaEmisorButton"
                                Content="Consultar constancia de inscripción del EMISOR"
                                Click="FiscalConsultarConstanciaEmisor_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FiscalConstanciaEmisorEstadoText"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="PERFILES FISCALES REUTILIZABLES (v0.16 - por CUIT)"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Los perfiles guardan versiones históricas. Cargá o seleccioná uno para completar automáticamente los datos del emisor. Los datos se declaran manualmente: Aparcar aún no los verifica con ARCA."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <ComboBox x:Name="FiscalPerfilesCombo" Width="610" HorizontalAlignment="Left"
                                  PlaceholderText="Seleccioná un perfil fiscal guardado"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="FiscalPerfilActualizarButton" Content="Buscar perfiles"
                                    Click="FiscalPerfilActualizar_Click"/>
                            <Button x:Name="FiscalPerfilAplicarButton" Content="Aplicar perfil elegido"
                                    Click="FiscalPerfilAplicar_Click"/>
                            <Button x:Name="FiscalPerfilHistorialButton" Content="Ver historial de versiones"
                                    Click="FiscalPerfilHistorial_Click"/>
                        </StackPanel>
                        <Button x:Name="FiscalPerfilGuardarButton"
                                Content="Guardar datos del emisor como perfil / nueva versión"
                                Click="FiscalPerfilGuardar_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FiscalPerfilEstadoText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Opacity="0.8"/>
                        <TextBlock Text="DATOS COMERCIALES DE LA SOLICITUD (solo homologación)"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Seleccioná primero una solicitud Preparada. Estos datos se guardan una sola vez, antes de solicitar CAE de prueba. CUIT, documento e IVA receptor se toman de la solicitud reservada; no se permite cambiarlos."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBox x:Name="FiscalRazonSocialEmisorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Razón social del emisor"/>
                        <TextBox x:Name="FiscalNombreFantasiaEmisorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Nombre de fantasía (opcional)"/>
                        <TextBox x:Name="FiscalDomicilioEmisorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Domicilio comercial del emisor"/>
                        <TextBox x:Name="FiscalCondicionIvaEmisorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Condición frente al IVA del emisor"/>
                        <TextBox x:Name="FiscalIngresosBrutosEmisorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="N° Ingresos Brutos o condición de exento/no contribuyente"/>
                        <TextBox x:Name="FiscalInicioActividadesEmisorInput" Width="330" HorizontalAlignment="Left"
                                 PlaceholderText="Inicio actividades: yyyy-MM-dd"/>
                        <TextBox x:Name="FiscalNombreReceptorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Nombre o razón social del receptor"/>
                        <TextBox x:Name="FiscalDomicilioReceptorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Domicilio del receptor"/>
                        <TextBox x:Name="FiscalCorreoReceptorInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Correo receptor (opcional)"/>
                        <Button x:Name="FiscalGuardarClienteButton"
                                Content="Guardar cliente identificado / nueva versión"
                                Click="FiscalGuardarCliente_Click" HorizontalAlignment="Left"/>
                        <TextBox x:Name="FiscalDescripcionServicioInput" Width="480" HorizontalAlignment="Left"
                                 PlaceholderText="Detalle: estacionamiento, abono o lavadero"/>
                        <TextBox x:Name="FiscalCondicionVentaInput" Width="360" HorizontalAlignment="Left"
                                 PlaceholderText="Condición de venta (ej.: contado)"/>
                        <Button x:Name="FiscalGuardarDatosDocumentoButton"
                                Content="Guardar identidad comercial INMUTABLE de la solicitud"
                                Click="FiscalGuardarDatosDocumento_Click" HorizontalAlignment="Left"/>
                        <Button x:Name="FiscalEmitirButton" Content="Solicitar CAE de PRUEBA (confirmación requerida)"
                                Click="FiscalEmitir_Click" HorizontalAlignment="Left"/>
                        <Button x:Name="FiscalConciliarButton" Content="Consultar ARCA para conciliar solicitud incierta"
                                Click="FiscalConciliar_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="COPIAS DE HOMOLOGACIÓN - NO SON FACTURAS VÁLIDAS"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Disponible solo para solicitudes de prueba Autorizadas con CAE; no se genera QR fiscal ni comprobante comercial."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <Button x:Name="FiscalGuardarPdfButton"
                                Content="Guardar PDF de PRUEBA (sin validez fiscal)"
                                Click="FiscalGuardarPdf_Click" HorizontalAlignment="Left"/>
                        <Button x:Name="FiscalImprimirButton"
                                Content="Imprimir copia de PRUEBA en impresora configurada"
                                Click="FiscalImprimir_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FiscalResultadoText" IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Control documental" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="CONTROL DOCUMENTAL DE COBROS" FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Consulta de seguimiento local: X no fiscal, devoluciones y solicitudes ARCA exclusivamente de HOMOLOGACIÓN. No se verifica facturación de producción ni se considera cumplida por un Ticket X."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <Button x:Name="ControlDocumentalActualizarButton"
                                Content="Consultar estado documental de cobros"
                                Click="ControlDocumentalActualizar_Click"
                                HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ControlDocumentalEstadoText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                        <ListView x:Name="ControlDocumentalCobrosList" Width="650" Height="230"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Caja y respaldos" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="SEGURIDAD DE CAJA" FontWeight="SemiBold" FontSize="18"/>
                        <CheckBox x:Name="CajaCiegaObligatoriaCheck"
                                  Content="Exigir caja ciega para todos los turnos"
                                  IsChecked="False"/>
                        <Button x:Name="GuardarPoliticaCajaButton" Content="Guardar política de caja"
                                Click="GuardarPoliticaCaja_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="El cajero no puede desactivar la caja ciega obligatoria. Se configura con el turno cerrado." Opacity="0.7" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RutaDatosText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="RESPALDO AUTOMÁTICO DE SEGURIDAD" FontSize="18" FontWeight="SemiBold"/>
                        <CheckBox x:Name="RespaldoAutomaticoInicioCheck"
                                  Content="Crear un respaldo consistente automáticamente al iniciar Aparcar"
                                  IsChecked="True"/>
                        <Button x:Name="GuardarRespaldoPoliticaButton" Content="Guardar política de respaldos"
                                Click="GuardarRespaldoPolitica_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="RespaldoEstadoText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <Button Content="Crear respaldo consistente" Click="Respaldar_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="RECUPERACIÓN SEGURA DE RESPALDOS" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Elegí una base Aparcar (.db). Primero se verifica su integridad. Al preparar la restauración no se reemplazan datos todavía; se aplica al reiniciar el programa."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="RutaRespaldoInput" Width="500"
                                     PlaceholderText="Ruta de respaldo .db"/>
                            <Button Content="Examinar" Click="ExaminarRespaldo_Click"/>
                        </StackPanel>
                        <Button Content="Verificar integridad del respaldo"
                                Click="VerificarRespaldo_Click" HorizontalAlignment="Left"/>
                        <Button x:Name="PrepararRestauracionButton" Content="Preparar restauración al reiniciar"
                                Click="PrepararRestauracion_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="EstadoRestauracionText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                        <TextBlock Text="El respaldo se guarda en Documentos/Aparcar/Respaldos. Copiá además una copia fuera de esta computadora."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView.TabItems>
    </TabView>
</Grid>
            </Grid>
        </NavigationView>
        <Border x:Name="PantallaAcceso" Grid.Row="1" Background="#F3F6FB"
                Padding="28" Visibility="Visible">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="500" HorizontalAlignment="Center" Spacing="16">
                    <TextBlock Text="APARCAR" FontWeight="Bold" FontSize="35" Foreground="#164677"/>
                    <TextBlock Text="Acceso seguro a gestión de estacionamientos"
                               FontSize="17" Foreground="#164677"/>
                    <StackPanel x:Name="PrimerAdministradorPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Configuración inicial" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Creá el primer administrador. No existen usuarios ni contraseñas predeterminadas."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Usuario administrador"/>
                        <TextBox x:Name="AdminInicialUsuarioInput" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="Contraseña (10 a 128 caracteres, con letras y números)"/>
                        <PasswordBox x:Name="AdminInicialPasswordBox" Width="320" HorizontalAlignment="Left"/>
                        <Button Content="Crear administrador e ingresar" Click="CrearAdministradorInicial_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel x:Name="LoginPanel" Spacing="12" Visibility="Visible">
                        <TextBlock Text="Iniciar sesión" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Usuario"/>
                        <TextBox x:Name="LoginUsuarioInput" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="Contraseña"/>
                        <PasswordBox x:Name="LoginPasswordBox" Width="320" HorizontalAlignment="Left"/>
                        <Button Content="Ingresar a Aparcar" Click="Login_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="Tras cinco intentos erróneos la cuenta se bloquea temporalmente."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock x:Name="AccesoMensaje" TextWrapping="Wrap" Foreground="#B91C1C"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="SplashOverlay" Grid.RowSpan="2" Background="#164677" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="420">
                <TextBlock Text="APARCAR" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"/>
                <ProgressRing IsActive="True" Width="42" Height="42" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashEstadoText" Text="Inicializando base de datos, configuración y seguridad…"
                           Foreground="White" FontSize="16" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
