<Window
    x:Class="Aparcar.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#164677" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="APARCAR" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="UsuarioActivoTexto" Text="Sin sesión" Foreground="White"
                           VerticalAlignment="Center"/>
                <Button x:Name="SalirButton" Content="Cerrar sesión" Click="CerrarSesion_Click"
                        Visibility="Collapsed"/>
                <TextBlock x:Name="Mensaje" Text="v0.7 · Flotas, renovaciones y reintegros · Versión técnica"
                           Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <NavigationView x:Name="Navegacion" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        SelectionChanged="Navegacion_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Inicio" Tag="inicio" Icon="Home"/>
                <NavigationViewItem Content="Nuevo ingreso" Tag="ingreso" Icon="Add"/>
                <NavigationViewItem Content="Salida y cobro" Tag="salida" Icon="Forward"/>
                <NavigationViewItem Content="Vehículos presentes" Tag="presentes" Icon="List"/>
                <NavigationViewItem Content="Tarifas" Tag="tarifas" Icon="Calculator"/>
                <NavigationViewItem Content="Caja" Tag="caja" Icon="Library"/>
                <NavigationViewItem Content="Lavadero" Tag="lavadero" Icon="Setting"/>
                <NavigationViewItem Content="Abonados" Tag="abonados" Icon="People"/>
                <NavigationViewItem Content="Reportes" Tag="reportes" Icon="Document"/>
                <NavigationViewItem Content="Configuración" Tag="config" Icon="Setting"/>
                <NavigationViewItem x:Name="MenuUsuarios" Content="Usuarios" Tag="usuarios" Icon="People"
                                    Visibility="Collapsed"/>
                <NavigationViewItem x:Name="MenuAuditoria" Content="Auditoría" Tag="auditoria" Icon="Document"
                                    Visibility="Collapsed"/>
            </NavigationView.MenuItems>
            <Grid Margin="24">
                <ScrollViewer x:Name="InicioPanel" Visibility="Visible">
                    <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Panel principal" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Aparcar v0.7 · Datos locales · Versión técnica no fiscal." Opacity="0.7"/>
                        <TextBlock x:Name="TotalActivosText" Text="0" FontSize="44" FontWeight="Bold"/>
                        <TextBlock Text="Vehículos presentes" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Nuevo ingreso" Click="IrIngreso_Click"/>
                            <Button Content="Buscar salida" Click="IrSalida_Click"/>
                            <Button Content="Actualizar" Click="Actualizar_Click"/>
                        </StackPanel>
                        <TextBlock Text="Últimos vehículos presentes" FontWeight="SemiBold" FontSize="18"/>
                        <ListView x:Name="ResumenActivosList" MinHeight="240" Width="640" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="IngresoPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="Registrar ingreso" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Los datos se guardan en SQLite antes de cualquier impresión." Opacity="0.7"/>
                        <TextBlock Text="Patente o identificador"/>
                        <TextBox x:Name="PatenteInput" KeyDown="PatenteInput_KeyDown" PlaceholderText="Ej.: AF123BC" MaxLength="20" Width="360" HorizontalAlignment="Left"/>
                        <TextBlock Text="Tipo de vehículo"/>
                        <ComboBox x:Name="TipoInput" KeyDown="TipoInput_KeyDown" SelectedIndex="0" Width="240" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Moto"/>
                            <ComboBoxItem Content="Camioneta"/>
                        </ComboBox>
                        <TextBlock Text="Sector"/>
                        <TextBox x:Name="SectorInput" KeyDown="SectorInput_KeyDown" Text="General" Width="360" HorizontalAlignment="Left"/>
                        <CheckBox x:Name="AutoImprimirCheck" Content="Imprimir el ticket automáticamente después de guardar"
                                  IsChecked="True" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="GuardarIngresoButton" Content="F10 — Guardar ingreso" Click="Ingresar_Click"/>
                            <Button Content="Configurar impresora" Click="IrConfig_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TicketPreviewText" Text="Enter: patente → categoría → sector → guardar."
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.85"/>
                        <TextBlock Text="El ingreso queda guardado aunque falle la impresora; reimprimí sin registrarlo otra vez."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SalidaPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Salida y cobranza" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Buscá por patente, ticket o QR. Pagos electrónicos solo después de verificar en su proveedor."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="BusquedaInput" KeyDown="BusquedaInput_KeyDown" Width="320" PlaceholderText="Ticket o patente"/>
                            <Button Content="Buscar" Click="Buscar_Click"/>
                        </StackPanel>
                        <Border Background="#E9F2FF" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="SalidaDetalleText" Text="Buscá una estadía activa."
                                           Foreground="#164677" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SalidaImporteText" Text="" FontSize="30"
                                           FontWeight="Bold" Foreground="#164677"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="CotizacionVigenciaText" Text="" Opacity="0.7"/>
                        <TextBlock Text="Medio de pago:"/>
                        <ComboBox x:Name="MedioPagoCombo" Width="260" HorizontalAlignment="Left"
                                  SelectedIndex="0" SelectionChanged="MedioPagoCombo_SelectionChanged">
                            <ComboBoxItem Content="Efectivo" Tag="Efectivo"/>
                            <ComboBoxItem Content="Débito" Tag="Debito"/>
                            <ComboBoxItem Content="Crédito" Tag="Credito"/>
                            <ComboBoxItem Content="Transferencia" Tag="Transferencia"/>
                            <ComboBoxItem Content="QR" Tag="QR"/>
                        </ComboBox>
                        <StackPanel x:Name="EfectivoPanel" Spacing="8">
                            <TextBlock Text="Efectivo entregado por el cliente (ARS):"/>
                            <TextBox x:Name="EfectivoRecibidoInput" TextChanged="EfectivoRecibidoInput_TextChanged" PlaceholderText="Ej.: 5000" Width="240"
                                 HorizontalAlignment="Left" KeyDown="EfectivoRecibidoInput_KeyDown"/>
                        </StackPanel>
                        <StackPanel x:Name="ElectronicoPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Referencia de pago comprobada (nº operación o autorización)"/>
                            <TextBox x:Name="ReferenciaElectronicaInput" Width="365"
                                     MaxLength="200" PlaceholderText="Referencia real del proveedor"/>
                            <CheckBox x:Name="PagoVerificadoCheck" Content="Verifiqué la acreditación/autorización en el proveedor"/>
                            <TextBlock Text="Aparcar NO consulta bancos ni pasarelas: esto es una declaración manual."
                                       TextWrapping="Wrap" Opacity="0.7"/>
                        </StackPanel>
                        <TextBlock x:Name="VueltoPrevistoText" Text="" FontWeight="SemiBold"/>
                        <Button x:Name="ConfirmarSalidaButton" Content="Confirmar cobro y finalizar salida"
                                Click="ConfirmarSalida_Click" HorizontalAlignment="Left"
                                IsEnabled="False"/>
                        <TextBlock Text="Confirmá solamente un pago efectivamente recibido/verificado. Caja y salida se registran en una misma transacción."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PresentesPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="750" HorizontalAlignment="Left">
                        <TextBlock Text="Vehículos presentes" FontSize="30" FontWeight="Bold"/>
                        <Button Content="Actualizar listado" Click="Actualizar_Click" HorizontalAlignment="Left"/>
                        <ListView x:Name="PresentesList" MinHeight="380" Width="640" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TarifasPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Tarifas configurables" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Una tarifa nueva se aplica a los próximos ingresos. Las estadías anteriores conservan sus precios." TextWrapping="Wrap" Opacity="0.7"/>
                        <ComboBox x:Name="TipoTarifaCombo" Width="250" HorizontalAlignment="Left"
                                  SelectionChanged="TipoTarifaCombo_SelectionChanged">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Moto"/>
                            <ComboBoxItem Content="Camioneta"/>
                        </ComboBox>
                        <TextBlock x:Name="VersionTarifaText" Text=""/>
                        <TextBlock Text="Primera hora ($)"/>
                        <TextBox x:Name="PrimeraHoraInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Fracción adicional ($)"/>
                        <TextBox x:Name="FraccionPrecioInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Minutos por fracción"/>
                        <TextBox x:Name="MinutosFraccionInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Máximo por 24 horas ($)"/>
                        <TextBox x:Name="TopeDiaInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Cortesía inicial en minutos"/>
                        <TextBox x:Name="CortesiaInput" Width="230" HorizontalAlignment="Left"/>
                        <Button Content="Guardar nueva versión de tarifa" Click="GuardarTarifa_Click"
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="IMPORTANTE: aún no existe control de roles. No utilizar esta versión con operadores no autorizados."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="CajaPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Caja principal — efectivo y medios electrónicos" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="CajaEstadoText" Text="Sin turno abierto" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="APERTURA DE TURNO" FontWeight="Bold"/>
                        <TextBlock Text="Operador responsable"/>
                        <TextBox x:Name="OperadorCajaInput" Width="320" HorizontalAlignment="Left" PlaceholderText="Nombre o identificador"/>
                        <TextBlock Text="Fondo inicial ($)"/>
                        <TextBox x:Name="FondoInicialInput" Width="230" HorizontalAlignment="Left" Text="0"/>
                        <Button x:Name="AbrirCajaButton" Content="Abrir caja" Click="AbrirCaja_Click"
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="MOVIMIENTOS DE EFECTIVO" FontWeight="Bold"/>
                        <ComboBox x:Name="MovimientoTipoCombo" Width="180" SelectedIndex="0" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Depósito" Tag="Deposito"/>
                            <ComboBoxItem Content="Retiro" Tag="Retiro"/>
                        </ComboBox>
                        <TextBox x:Name="MovimientoMontoInput" PlaceholderText="Monto en ARS" Width="235" HorizontalAlignment="Left"/>
                        <TextBox x:Name="MovimientoMotivoInput" PlaceholderText="Motivo obligatorio" Width="430" MaxLength="300" HorizontalAlignment="Left"/>
                        <Button Content="Registrar movimiento" Click="MovimientoManual_Click" HorizontalAlignment="Left"/>
                        <ListView x:Name="MovimientosCajaList" Width="670" MaxHeight="150" HorizontalAlignment="Left"/>
                        <TextBlock Text="DEVOLUCIONES DE EFECTIVO" FontWeight="Bold"/>
                        <TextBlock Text="PIN local básico: no sustituye usuarios y permisos reales." Opacity="0.7"/>
                        <PasswordBox x:Name="PinInicialBox" PlaceholderText="Crear PIN de supervisor (6-12 dígitos)" Width="340" HorizontalAlignment="Left"/>
                        <Button x:Name="CrearPinButton" Content="Configurar PIN inicial" Click="CrearPin_Click" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="CobrosDevolucionCombo" PlaceholderText="Elegí cobro en efectivo" Width="460" HorizontalAlignment="Left"/>
                        <TextBox x:Name="MotivoDevolucionInput" Width="440" MaxLength="300" HorizontalAlignment="Left" PlaceholderText="Motivo de devolución completa"/>
                        <TextBox x:Name="AutorizadorInput" Width="340" HorizontalAlignment="Left" PlaceholderText="Nombre del supervisor"/>
                        <PasswordBox x:Name="PinDevolucionBox" PlaceholderText="PIN de supervisor" Width="230" HorizontalAlignment="Left"/>
                        <Button Content="Solicitar devolución completa" Click="DevolverEfectivo_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ResultadoDevolucionText" TextWrapping="Wrap"/>
                        <TextBlock Text="DEVOLUCIONES DE LAVADERO Y ABONOS (SOLO EFECTIVO)" FontWeight="Bold"/>
                        <ComboBox x:Name="DevolucionComplementoCombo" Width="530"
                                  HorizontalAlignment="Left" PlaceholderText="Elegir cobro complementario"/>
                        <TextBox x:Name="DevolucionComplementoMotivoInput" Width="440"
                                 HorizontalAlignment="Left" MaxLength="300" PlaceholderText="Motivo (mínimo 8 caracteres)"/>
                        <TextBox x:Name="DevolucionComplementoSupervisorInput" Width="330"
                                 HorizontalAlignment="Left" PlaceholderText="Supervisor que autoriza"/>
                        <PasswordBox x:Name="DevolucionComplementoPin" Width="230"
                                     HorizontalAlignment="Left" PlaceholderText="PIN del supervisor"/>
                        <Button Content="Registrar devolución completa del complemento"
                                Click="DevolverComplemento_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="Un abono utilizado o un lavado ya entregado no admite devolución automática."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                        <TextBlock Text="CIERRE Y ARQUEO" FontWeight="Bold"/>
                        <TextBlock Text="Efectivo contado en la caja ($)"/>
                        <TextBox x:Name="EfectivoContadoInput" Width="230" HorizontalAlignment="Left"/>
                        <Button x:Name="CerrarCajaButton" Content="Cerrar turno y registrar arqueo" Click="CerrarCaja_Click"
                                HorizontalAlignment="Left" IsEnabled="False"/>
                        <TextBlock x:Name="UltimoArqueoText" Text="" TextWrapping="Wrap"/>
                        <TextBlock Text="ÚLTIMOS COBROS" FontWeight="Bold"/>
                        <ListView x:Name="CobrosCajaList" Width="670" MinHeight="160"
                                  HorizontalAlignment="Left"/>
                        <Button Content="Actualizar caja" Click="ActualizarCaja_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="v0.4: pago externo verificado DECLARADO por operador. Sin autenticación de usuarios ni conciliación bancaria: no habilitado para producción."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LavaderoPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Lavadero" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Órdenes de trabajo y cobros separados del estacionamiento. No generan otro ingreso del vehículo."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="CATÁLOGO DE SERVICIOS" FontWeight="SemiBold"/>
                        <TextBox x:Name="LavServicioNombreInput" Width="360" HorizontalAlignment="Left"
                                 PlaceholderText="Nombre (ej.: Lavado completo)"/>
                        <ComboBox x:Name="LavServicioTipoCombo" SelectedIndex="0" Width="220"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Moto"/>
                            <ComboBoxItem Content="Camioneta"/>
                        </ComboBox>
                        <TextBox x:Name="LavServicioPrecioInput" Width="220" HorizontalAlignment="Left"
                                 PlaceholderText="Precio ARS"/>
                        <Button x:Name="LavGuardarServicioButton" Content="Guardar nueva versión del servicio"
                                Click="GuardarServicioLavado_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="NUEVA ORDEN" FontWeight="SemiBold"/>
                        <ComboBox x:Name="LavServiciosCombo" Width="480" HorizontalAlignment="Left"
                                  PlaceholderText="Seleccionar servicio"/>
                        <TextBox x:Name="LavPatenteInput" Width="240" HorizontalAlignment="Left"
                                 PlaceholderText="Patente"/>
                        <TextBox x:Name="LavOperarioInput" Width="320" HorizontalAlignment="Left"
                                 PlaceholderText="Operario asignado"/>
                        <TextBox x:Name="LavObservacionesInput" Width="480" MaxLength="500"
                                 HorizontalAlignment="Left" PlaceholderText="Observaciones"/>
                        <CheckBox x:Name="LavVincularEstadiaCheck"
                                  Content="Vincular a una estadía activa de esta patente"/>
                        <Button x:Name="LavCrearOrdenButton" Content="Crear orden de lavado"
                                Click="CrearOrdenLavado_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="ÓRDENES (seleccioná una)" FontWeight="SemiBold"/>
                        <ListView x:Name="LavOrdenesList" Width="710" Height="185"
                                  HorizontalAlignment="Left" SelectionMode="Single"/>
                        <ComboBox x:Name="LavEstadoCombo" Width="215" HorizontalAlignment="Left"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="EnProceso" Tag="EnProceso"/>
                            <ComboBoxItem Content="Terminado" Tag="Terminado"/>
                            <ComboBoxItem Content="Entregado" Tag="Entregado"/>
                            <ComboBoxItem Content="Cancelado" Tag="Cancelado"/>
                        </ComboBox>
                        <Button x:Name="LavCambiarEstadoButton" Content="Actualizar estado de la orden seleccionada"
                                Click="CambiarEstadoLavado_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="COBRAR ORDEN SELECCIONADA" FontWeight="SemiBold"/>
                        <ComboBox x:Name="LavPagoMedioCombo" Width="230" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Efectivo" Tag="Efectivo"/>
                            <ComboBoxItem Content="Débito" Tag="Debito"/>
                            <ComboBoxItem Content="Crédito" Tag="Credito"/>
                            <ComboBoxItem Content="Transferencia" Tag="Transferencia"/>
                            <ComboBoxItem Content="QR" Tag="QR"/>
                        </ComboBox>
                        <TextBox x:Name="LavRecibidoInput" Width="220" HorizontalAlignment="Left"
                                 PlaceholderText="Efectivo entregado / total externo"/>
                        <TextBox x:Name="LavReferenciaInput" Width="420" HorizontalAlignment="Left"
                                 PlaceholderText="Referencia de pago externo"/>
                        <CheckBox x:Name="LavVerificadoCheck"
                                  Content="Verifiqué el pago externo en su proveedor"/>
                        <Button x:Name="LavCobrarButton" Content="Confirmar cobro de lavado"
                                Click="CobrarLavado_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="Los pagos externos se verifican manualmente. El pago de la orden se registra una sola vez."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AbonadosPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Abonados" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Cobertura 24 horas o nocturna (20:00–08:00). Renovaciones, hasta 5 patentes y pago antes de activar."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="CATÁLOGO DE PLANES" FontWeight="SemiBold"/>
                        <TextBox x:Name="AbPlanNombreInput" Width="370" HorizontalAlignment="Left"
                                 PlaceholderText="Nombre del plan"/>
                        <ComboBox x:Name="AbPlanTipoCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Moto"/>
                            <ComboBoxItem Content="Camioneta"/>
                        </ComboBox>
                        <ComboBox x:Name="AbPlanPeriodoCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="2">
                            <ComboBoxItem Content="Semanal"/>
                            <ComboBoxItem Content="Quincenal"/>
                            <ComboBoxItem Content="Mensual"/>
                        </ComboBox>
                        <TextBlock Text="Modalidad de cobertura"/>
                        <ComboBox x:Name="AbPlanModalidadCombo" Width="240" SelectedIndex="0"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="24 horas" Tag="Completa"/>
                            <ComboBoxItem Content="Nocturna 20:00–08:00" Tag="Nocturna"/>
                        </ComboBox>
                        <TextBox x:Name="AbPlanPrecioInput" Width="220" HorizontalAlignment="Left"
                                 PlaceholderText="Precio ARS"/>
                        <Button x:Name="AbGuardarPlanButton" Content="Guardar versión de plan"
                                Click="GuardarPlanAbono_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="NUEVO ABONO PENDIENTE" FontWeight="SemiBold"/>
                        <ComboBox x:Name="AbPlanesCombo" Width="500" HorizontalAlignment="Left"
                                  PlaceholderText="Seleccionar plan"/>
                        <TextBox x:Name="AbClienteInput" Width="400" HorizontalAlignment="Left"
                                 PlaceholderText="Cliente"/>
                        <TextBox x:Name="AbPatenteInput" Width="220" HorizontalAlignment="Left"
                                 PlaceholderText="Patente"/>
                        <Button x:Name="AbCrearContratoButton" Content="Crear contrato pendiente"
                                Click="CrearContratoAbono_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="CONTRATOS (seleccioná uno pendiente para cobrar)" FontWeight="SemiBold"/>
                        <ListView x:Name="AbContratosList" Width="710" Height="185"
                                  HorizontalAlignment="Left" SelectionMode="Single"
                                  SelectionChanged="AbContratosList_SelectionChanged"/>
                        <TextBlock Text="GESTIÓN DE PATENTES Y RENOVACIONES" FontWeight="SemiBold"/>
                        <TextBlock Text="Seleccioná contrato pendiente para editar patentes; uno activo para renovarlo."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBox x:Name="AbPatenteExtraInput" Width="220" HorizontalAlignment="Left"
                                 PlaceholderText="Otra patente autorizada"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Añadir patente" Click="AgregarPatenteAbono_Click"/>
                            <Button Content="Quitar patente" Click="QuitarPatenteAbono_Click"/>
                        </StackPanel>
                        <Button Content="Crear renovación del contrato seleccionado con el plan elegido"
                                Click="RenovarAbono_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AbVehiculosText" TextWrapping="Wrap"/>
                        <TextBlock Text="ACTIVAR MEDIANTE COBRO" FontWeight="SemiBold"/>
                        <ComboBox x:Name="AbPagoMedioCombo" Width="230" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Efectivo" Tag="Efectivo"/>
                            <ComboBoxItem Content="Débito" Tag="Debito"/>
                            <ComboBoxItem Content="Crédito" Tag="Credito"/>
                            <ComboBoxItem Content="Transferencia" Tag="Transferencia"/>
                            <ComboBoxItem Content="QR" Tag="QR"/>
                        </ComboBox>
                        <TextBox x:Name="AbRecibidoInput" Width="220" HorizontalAlignment="Left"
                                 PlaceholderText="Efectivo recibido / total externo"/>
                        <TextBox x:Name="AbReferenciaInput" Width="430" HorizontalAlignment="Left"
                                 PlaceholderText="Referencia de pago externo"/>
                        <CheckBox x:Name="AbVerificadoCheck"
                                  Content="Verifiqué el pago externo en el proveedor"/>
                        <Button x:Name="AbCobrarButton" Content="Cobrar y activar contrato pendiente"
                                Click="CobrarAbono_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="Cobertura sin retroactividad. La permanencia debe estar completamente dentro del horario y vigencia. Una renovación anticipada empieza al vencer la anterior."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ReportesPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="850" HorizontalAlignment="Left">
                        <TextBlock Text="Reportes de recaudación" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Cobros y devoluciones por fecha efectiva, separados por medio. No son reportes fiscales." TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="Fecha desde (dd/MM/aaaa)"/>
                        <TextBox x:Name="ReporteDesdeInput" Width="210" HorizontalAlignment="Left"/>
                        <TextBlock Text="Fecha hasta inclusive (dd/MM/aaaa)"/>
                        <TextBox x:Name="ReporteHastaInput" Width="210" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Consultar recaudación" Click="ConsultarReporte_Click"/>
                            <Button Content="Exportar Excel (.xlsx)" Click="ExportarExcel_Click"/>
                            <Button Content="Exportar PDF (.pdf)" Click="ExportarPdf_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ReporteTotalesText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <ListView x:Name="ReporteFilasList" Width="730" MinHeight="340"
                                  HorizontalAlignment="Left"/>
                        <TextBlock x:Name="RutaReporteText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="Excel y PDF exportan exactamente el período consultado; no son documentos fiscales."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="UsuariosPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Administración de usuarios" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Solo el administrador puede crear cuentas. Cada operador debe tener su contraseña personal."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="Nombre de usuario"/>
                        <TextBox x:Name="NuevoUsuarioInput" Width="300" HorizontalAlignment="Left"/>
                        <TextBlock Text="Contraseña (mínimo 10 caracteres, letras y números)"/>
                        <PasswordBox x:Name="NuevaContrasenaBox" Width="330" HorizontalAlignment="Left"/>
                        <TextBlock Text="Rol asignado"/>
                        <ComboBox x:Name="NuevoRolCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="2">
                            <ComboBoxItem Content="Administrador"/>
                            <ComboBoxItem Content="Supervisor"/>
                            <ComboBoxItem Content="Cajero"/>
                            <ComboBoxItem Content="Lavadero"/>
                            <ComboBoxItem Content="Consulta"/>
                        </ComboBox>
                        <Button Content="Crear usuario" Click="CrearUsuario_Click" HorizontalAlignment="Left"/>
                        <ListView x:Name="ListaUsuarios" Width="640" MinHeight="200"
                                  HorizontalAlignment="Left" SelectionMode="Single"/>
                        <TextBlock Text="EDITAR CUENTA SELECCIONADA" FontWeight="SemiBold"/>
                        <TextBlock Text="Rol nuevo"/>
                        <ComboBox x:Name="RolCambioCombo" Width="250" SelectedIndex="2" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Administrador"/>
                            <ComboBoxItem Content="Supervisor"/>
                            <ComboBoxItem Content="Cajero"/>
                            <ComboBoxItem Content="Lavadero"/>
                            <ComboBoxItem Content="Consulta"/>
                        </ComboBox>
                        <Button Content="Cambiar rol seleccionado" Click="CambiarRolUsuario_Click"
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="Restablecer contraseña de la cuenta seleccionada"/>
                        <PasswordBox x:Name="ResetPasswordBox" Width="350" HorizontalAlignment="Left"/>
                        <Button Content="Restablecer contraseña" Click="RestablecerUsuario_Click"
                                HorizontalAlignment="Left"/>
                        <Button Content="Desactivar cuenta seleccionada" Click="DesactivarUsuario_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AuditoriaPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Registro de auditoría" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Registro encadenado para detectar modificaciones no autorizadas. No sustituye almacenamiento externo de auditoría."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <Button Content="Verificar integridad y actualizar" Click="VerificarAuditoria_Click"
                                HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AuditoriaEstadoText" TextWrapping="Wrap"/>
                        <ListView x:Name="ListaAuditoria" Width="700" MinHeight="340" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ConfigPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Configuración técnica" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Base SQLite local (una PC, una cuenta Windows):"/>
                        <TextBlock Text="IMPRESIÓN DE TICKETS" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="Impresora instalada en Windows:"/>
                        <ComboBox x:Name="ImpresorasCombo" Width="390" HorizontalAlignment="Left" PlaceholderText="Elegir impresora"/>
                        <TextBlock Text="Ancho de papel:"/>
                        <ComboBox x:Name="AnchoTicketCombo" SelectedIndex="1" Width="190" HorizontalAlignment="Left">
                            <ComboBoxItem Content="58 mm"/>
                            <ComboBoxItem Content="80 mm"/>
                        </ComboBox>
                        <Button Content="Guardar configuración de impresora" Click="GuardarImpresora_Click" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="TicketReimpresionInput" PlaceholderText="Nº ticket para reimprimir" Width="250"/>
                            <Button Content="Reimprimir ingreso" Click="ReimprimirTicket_Click"/>
                        </StackPanel>
                        <TextBlock Text="Usá una impresora con controlador Windows compatible. Los tickets QR son operativos, no fiscales."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock x:Name="RutaDatosText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <Button Content="Crear respaldo consistente" Click="Respaldar_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="El respaldo se guarda en Documentos/Aparcar/Respaldos. Copiá además una copia fuera de esta computadora."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <Border x:Name="PantallaAcceso" Grid.Row="1" Background="#F3F6FB"
                Padding="28" Visibility="Visible">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="500" HorizontalAlignment="Center" Spacing="16">
                    <TextBlock Text="APARCAR" FontWeight="Bold" FontSize="35" Foreground="#164677"/>
                    <TextBlock Text="Acceso seguro a gestión de estacionamientos"
                               FontSize="17" Foreground="#164677"/>
                    <StackPanel x:Name="PrimerAdministradorPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Configuración inicial" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Creá el primer administrador. No existen usuarios ni contraseñas predeterminadas."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Usuario administrador"/>
                        <TextBox x:Name="AdminInicialUsuarioInput" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="Contraseña (10 a 128 caracteres, con letras y números)"/>
                        <PasswordBox x:Name="AdminInicialPasswordBox" Width="320" HorizontalAlignment="Left"/>
                        <Button Content="Crear administrador e ingresar" Click="CrearAdministradorInicial_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel x:Name="LoginPanel" Spacing="12" Visibility="Visible">
                        <TextBlock Text="Iniciar sesión" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Usuario"/>
                        <TextBox x:Name="LoginUsuarioInput" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="Contraseña"/>
                        <PasswordBox x:Name="LoginPasswordBox" Width="320" HorizontalAlignment="Left"/>
                        <Button Content="Ingresar a Aparcar" Click="Login_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="Tras cinco intentos erróneos la cuenta se bloquea temporalmente."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock x:Name="AccesoMensaje" TextWrapping="Wrap" Foreground="#B91C1C"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
