<UserControl
    x:Class="Aparcar.Desktop.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#0F4C81"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#16A6A1"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F4F7FB"/>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="{StaticResource PageBrush}" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BrandBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,3" Padding="20,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="8,4">
                        <TextBlock Text="A" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="APARCAR" Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Gestión simple de estacionamientos" Foreground="#D8F4F2" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="UsuarioActivoTexto" Text="Sin sesión" Foreground="#E7F0FA" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="SalirButton" Content="Cerrar sesión" Click="CerrarSesion_Click" Visibility="Collapsed"/>
                <TextBlock Grid.Column="3" x:Name="Mensaje" Text="v0.26 · Operación segura" Foreground="#D8F4F2" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <NavigationView x:Name="Navegacion" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        SelectionChanged="Navegacion_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Inicio" Tag="inicio" Icon="Home"/>
                <NavigationViewItem Content="Nuevo ingreso" Tag="ingreso" Icon="Add"/>
                <NavigationViewItem Content="Salida y cobro" Tag="salida" Icon="Forward"/>
                <NavigationViewItem Content="Vehículos presentes" Tag="presentes" Icon="List"/>
                <NavigationViewItem x:Name="MenuTarifas" Content="Tarifas (configuración)" Tag="tarifas" Icon="Calculator"
                                    Visibility="Collapsed"/>
                <NavigationViewItem Content="Caja" Tag="caja" Icon="Library"/>
                <NavigationViewItem Content="Lavadero" Tag="lavadero" Icon="Setting"/>
                <NavigationViewItem Content="Abonados" Tag="abonados" Icon="People"/>
                <NavigationViewItem Content="Reportes" Tag="reportes" Icon="Document"/>
                <NavigationViewItem Content="Configuración" Tag="config" Icon="Setting"/>
                <NavigationViewItem x:Name="MenuUsuarios" Content="Usuarios" Tag="usuarios" Icon="People"
                                    Visibility="Collapsed"/>
                <NavigationViewItem x:Name="MenuAuditoria" Content="Auditoría" Tag="auditoria" Icon="Document"
                                    Visibility="Collapsed"/>
            </NavigationView.MenuItems>
            <Grid Margin="24">
                <Grid x:Name="InicioPanel" Visibility="Visible">
    <TabView x:Name="InicioPanelTabs" IsAddTabButtonVisible="False">
            <TabViewItem Header="Caja rápida">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Panel operativo" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Ingresá o cobrá con pocos pasos. F2: ingreso · F4: salida."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#E9F2FF" Padding="16" CornerRadius="10" MinWidth="200">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="VEHÍCULOS PRESENTES" Foreground="#164677" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TotalActivosText" Text="0" FontSize="38"
                                               Foreground="#164677" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#E9F2FF" Padding="16" CornerRadius="10" MinWidth="210">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="LUGARES DISPONIBLES" Foreground="#164677" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="InicioLibresText" Text="—" FontSize="38"
                                               Foreground="#164677" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="InicioOcupacionText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="InicioCajaEstadoText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="InicioNuevoIngresoButton" Content="F2 · Nuevo ingreso"
                                    Click="IrIngreso_Click"/>
                            <Button x:Name="InicioIrSalidaButton" Content="F4 · Salida y cobro"
                                    Click="IrSalida_Click"/>
                            <Button Content="Actualizar panel" Click="Actualizar_Click"/>
                        </StackPanel>
                        <TextBlock Text="BÚSQUEDA RÁPIDA" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Ingresá la patente o el número de ticket y presioná Enter."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="InicioBusquedaInput" Width="340" MaxLength="40"
                                     PlaceholderText="Patente o ticket"
                                     KeyDown="InicioBusqueda_KeyDown"/>
                            <Button Content="Buscar" Click="InicioBuscar_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="InicioBusquedaEstadoText" TextWrapping="Wrap"/>
                        <ListView x:Name="InicioCoincidenciasList" KeyDown="InicioCoincidencias_KeyDown" Visibility="Collapsed" Width="760" Height="130"
                                  SelectionChanged="InicioCoincidencias_SelectionChanged"
                                  HorizontalAlignment="Left"/>
                        <StackPanel x:Name="InicioOpcionesBusquedaPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="InicioEstimarSalidaButton" Content="Estimar tarifa actual"
                                    Click="InicioEstimarSalida_Click" IsEnabled="False"/>
                            <Button x:Name="InicioPrepararSalidaButton" Content="Preparar cobro"
                                    Click="InicioPrepararSalida_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="InicioEstimacionText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                        <Border x:Name="InicioCobroPanelV23" Visibility="Collapsed"
                                Background="#E9F2FF" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="10" MaxWidth="700">
                                <TextBlock Text="CAJA RÁPIDA · SALIDA PREPARADA"
                                           FontSize="18" FontWeight="SemiBold" Foreground="#164677"/>
                                <TextBlock x:Name="InicioCobroDetalleText" TextWrapping="Wrap"
                                           Foreground="#164677" IsTextSelectionEnabled="True"/>
                                <TextBlock x:Name="InicioCobroImporteText" FontSize="28"
                                           FontWeight="Bold" Foreground="#164677"/>
                                <TextBlock x:Name="InicioCobroVigenciaText"
                                           Foreground="#164677" TextWrapping="Wrap"/>
                                <TextBlock Text="Medio de pago" Foreground="#164677"/>
                                <ComboBox x:Name="InicioCobroMedioCombo" Width="250"
                                          HorizontalAlignment="Left" SelectedIndex="0"
                                          SelectionChanged="InicioCobroMedio_SelectionChanged"
                                          KeyDown="InicioCobroMedio_KeyDown">
                                    <ComboBoxItem Content="Efectivo" Tag="Efectivo"/>
                                    <ComboBoxItem Content="Débito" Tag="Debito"/>
                                    <ComboBoxItem Content="Crédito" Tag="Credito"/>
                                    <ComboBoxItem Content="Transferencia" Tag="Transferencia"/>
                                    <ComboBoxItem Content="QR" Tag="QR"/>
                                </ComboBox>
                                <StackPanel x:Name="InicioCobroEfectivoPanel" Spacing="6">
                                    <TextBlock Text="Efectivo recibido (se propone el importe exacto)" Foreground="#164677"/>
                                    <TextBox x:Name="InicioCobroRecibidoInput" Width="250"
                                             HorizontalAlignment="Left" PlaceholderText="Ej.: 5000"
                                             TextChanged="InicioCobroRecibido_TextChanged"
                                             KeyDown="InicioCobroRecibido_KeyDown"/>
                                </StackPanel>
                                <StackPanel x:Name="InicioCobroElectronicoPanel"
                                            Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="Referencia REAL del banco, tarjeta o billetera"
                                               Foreground="#164677"/>
                                    <TextBox x:Name="InicioCobroReferenciaInput" Width="400"
                                             MaxLength="200" HorizontalAlignment="Left"
                                             PlaceholderText="Nº de operación, mínimo 4 caracteres"
                                             KeyDown="InicioCobroReferencia_KeyDown"/>
                                    <CheckBox x:Name="InicioCobroVerificadoCheck"
                                              Content="Verifiqué manualmente el pago en el proveedor"
                                              KeyDown="InicioCobroVerificado_KeyDown"/>
                                    <TextBlock Text="Aparcar no verifica transferencias, tarjetas ni QR automáticamente."
                                               Foreground="#164677" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="InicioCobroVueltoText" Foreground="#164677"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <CheckBox x:Name="InicioCobroEmitirXCheck" IsChecked="False"
                                          Content="Emitir Ticket X NO FISCAL para este cobro (si hay talonario e impresora)"/>
                                <TextBlock Text="Ticket X y recibo no sustituyen factura ARCA. Si no se elige X, se aplica la preferencia de impresión automática del recibo."
                                           Foreground="#164677" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="InicioConfirmarCobroButton"
                                            Content="F10 · Confirmar cobro y salida"
                                            Click="InicioConfirmarCobro_Click" IsEnabled="False"/>
                                    <Button Content="Usar formulario completo"
                                            Click="InicioIrFormularioSalida_Click"/>
                                    <Button Content="Cancelar preparación"
                                            Click="InicioCancelarCobro_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="InicioCobroEstadoText" Foreground="#164677"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="InicioPanelEstadoText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Opacity="0.8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Ocupación y movimientos">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="OCUPACIÓN POR SECTOR" FontSize="18" FontWeight="SemiBold"/>
                        <ListView x:Name="InicioSectoresList" Width="760" Height="136"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="ÚLTIMOS INGRESOS QUE SIGUEN PRESENTES"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <ListView x:Name="ResumenActivosList" Width="760" Height="170"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="ÚLTIMAS SALIDAS COBRADAS"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <ListView x:Name="InicioUltimasSalidasList" Width="760" Height="170"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
    </TabView>
</Grid>

                <ScrollViewer x:Name="IngresoPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="650" HorizontalAlignment="Left">
                        <TextBlock Text="Registrar ingreso" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Los datos se guardan en SQLite antes de cualquier impresión." Opacity="0.7"/>
                        <TextBlock Text="Patente o identificador"/>
                        <TextBox x:Name="PatenteInput" KeyDown="PatenteInput_KeyDown" PlaceholderText="Ej.: AF123BC" MaxLength="20" Width="360" HorizontalAlignment="Left"/>
                        <TextBlock Text="Tipo de vehículo"/>
                        <ComboBox x:Name="TipoInput" KeyDown="TipoInput_KeyDown" SelectedIndex="0" Width="240" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Moto"/>
                            <ComboBoxItem Content="Camioneta"/>
                        </ComboBox>
                        <TextBlock Text="Sector"/>
                        <ComboBox x:Name="SectoresIngresoCombo" KeyDown="SectoresIngresoCombo_KeyDown" Width="360"
                                  HorizontalAlignment="Left" PlaceholderText="Seleccionar sector"
                                  SelectionChanged="SectoresIngresoCombo_SelectionChanged"/>
                        <TextBox x:Name="SectorInput" Text="General"
                                 Visibility="Collapsed" IsReadOnly="True" Width="360" HorizontalAlignment="Left"/>
                        <TextBlock Text="Plaza (solo para sectores de asignación individual; vacío = automática)"/>
                        <TextBox x:Name="PlazaIngresoInput" KeyDown="PlazaIngresoInput_KeyDown"
                                 Width="240" HorizontalAlignment="Left" PlaceholderText="Ej.: A-01"/>
                        <TextBlock x:Name="IngresoSectorDisponibilidadText" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="GuardarIngresoButton" Content="F10 — Guardar ingreso" Click="Ingresar_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TicketPreviewText" Text="Enter: patente → tipo → guardar (si hay un solo sector). Usá Tab para elegir una plaza; F10 también guarda."
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.85"/>
                        <TextBlock Text="El ingreso queda guardado aunque falle la impresora; reimprimí sin registrarlo otra vez."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="SalidaPanel" Visibility="Collapsed">
    <TabView x:Name="SalidaPanelTabs" IsAddTabButtonVisible="False">
            <TabViewItem Header="Cobrar">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Salida y cobranza" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Buscá por patente, ticket o QR. Pagos electrónicos solo después de verificar en su proveedor."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="BusquedaInput" KeyDown="BusquedaInput_KeyDown" Width="320" PlaceholderText="Ticket o patente"/>
                            <Button Content="Buscar" Click="Buscar_Click"/>
                        </StackPanel>
                        <Border Background="#E9F2FF" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="SalidaDetalleText" Text="Buscá una estadía activa."
                                           Foreground="#164677" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SalidaImporteText" Text="" FontSize="30"
                                           FontWeight="Bold" Foreground="#164677"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="CotizacionVigenciaText" Text="" Opacity="0.7"/>
                        <TextBlock Text="Medio de pago:"/>
                        <ComboBox x:Name="MedioPagoCombo" Width="260" HorizontalAlignment="Left"
                                  SelectedIndex="0" SelectionChanged="MedioPagoCombo_SelectionChanged" KeyDown="MedioPagoCombo_KeyDown">
                            <ComboBoxItem Content="Efectivo" Tag="Efectivo"/>
                            <ComboBoxItem Content="Débito" Tag="Debito"/>
                            <ComboBoxItem Content="Crédito" Tag="Credito"/>
                            <ComboBoxItem Content="Transferencia" Tag="Transferencia"/>
                            <ComboBoxItem Content="QR" Tag="QR"/>
                        </ComboBox>
                        <StackPanel x:Name="EfectivoPanel" Spacing="8">
                            <TextBlock Text="Efectivo recibido (se propone el importe exacto; podés cambiarlo):"/>
                            <TextBox x:Name="EfectivoRecibidoInput" TextChanged="EfectivoRecibidoInput_TextChanged" PlaceholderText="Ej.: 5000" Width="240"
                                 HorizontalAlignment="Left" KeyDown="EfectivoRecibidoInput_KeyDown"/>
                        </StackPanel>
                        <StackPanel x:Name="ElectronicoPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Referencia de pago comprobada (nº operación o autorización)"/>
                            <TextBox x:Name="ReferenciaElectronicaInput" Width="365"
                                     MaxLength="200" PlaceholderText="Referencia real del proveedor" KeyDown="ReferenciaElectronicaInput_KeyDown"/>
                            <CheckBox x:Name="PagoVerificadoCheck" Content="Verifiqué la acreditación/autorización en el proveedor" KeyDown="PagoVerificadoCheck_KeyDown"/>
                            <TextBlock Text="Aparcar NO consulta bancos ni pasarelas: esto es una declaración manual."
                                       TextWrapping="Wrap" Opacity="0.7"/>
                        </StackPanel>
                        <TextBlock x:Name="VueltoPrevistoText" Text="" FontWeight="SemiBold"/>
                        <CheckBox x:Name="SalidaEmitirXCheck"
                                  Content="Emitir ticket X NO FISCAL al confirmar este cobro"
                                  IsChecked="False"/>
                        <Button x:Name="ConfirmarSalidaButton" Content="F10 · Confirmar cobro y salida"
                                Click="ConfirmarSalida_Click" HorizontalAlignment="Left"
                                IsEnabled="False"/>
                        <TextBlock Text="Confirmá solamente un pago efectivamente recibido/verificado. Caja y salida se registran en una misma transacción."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="Enter: buscar → medio → importe/referencia → confirmar. F5: buscar · F10: confirmar cobro. La verificación electrónica se tilda con Espacio, nunca automáticamente."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock x:Name="SalidaResultadoReciboText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Recibos">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="HISTORIAL Y RECUPERACIÓN DE RECIBOS DE COBRO"
                                   FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="El recibo es NO FISCAL. Recuperar una impresión nunca crea otro cobro. Enviado al controlador no garantiza papel impreso."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <Button x:Name="ReciboCobroActualizarButton" Content="Actualizar recibos de cobro"
                                Click="ReciboCobroActualizar_Click" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="RecibosCobroCombo" Width="650" HorizontalAlignment="Left"
                                  PlaceholderText="Elegí un cobro confirmado del historial"/>
                        <TextBlock Text="FACTURACIÓN DEL COBRO SELECCIONADO" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="La factura se prepara desde este cobro. Después elegí cliente identificado o Consumidor Final en la pantalla fiscal."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="FacturarCobroButton" Content="Facturar cobro seleccionado"
                                    Click="FacturarCobroSeleccionado_Click" HorizontalAlignment="Left"/>
                            <Button x:Name="FacturarConsumidorFinalButton" Content="Facturar a consumidor final"
                                    Click="FacturarConsumidorFinal_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Button x:Name="ReciboCobroImprimirOriginalButton"
                                Content="Imprimir ORIGINAL sin intento previo"
                                Click="ReciboCobroImprimirOriginal_Click" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ReciboCobroMotivoCopiaInput" Width="500" MaxLength="250"
                                 HorizontalAlignment="Left"
                                 PlaceholderText="Motivo de COPIA (mínimo 8 caracteres)"/>
                        <Button x:Name="ReciboCobroImprimirCopiaButton"
                                Content="Imprimir COPIA (supervisor)"
                                Click="ReciboCobroImprimirCopia_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ReciboCobroHistorialEstadoText" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
    </TabView>
</Grid>

                <ScrollViewer x:Name="PresentesPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="750" HorizontalAlignment="Left">
                        <TextBlock Text="Vehículos presentes" FontSize="30" FontWeight="Bold"/>
                        <Button Content="Actualizar listado" Click="Actualizar_Click" HorizontalAlignment="Left"/>
                        <ListView x:Name="PresentesList" MinHeight="380" Width="640" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="TarifasPanel" Visibility="Collapsed">
    <TabView x:Name="TarifasPanelTabs" IsAddTabButtonVisible="False">
            <TabViewItem Header="Tarifas generales">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Tarifas configurables" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Una tarifa nueva se aplica a los próximos ingresos. Las estadías anteriores conservan sus precios." TextWrapping="Wrap" Opacity="0.7"/>
                        <ComboBox x:Name="TipoTarifaCombo" Width="250" HorizontalAlignment="Left"
                                  SelectionChanged="TipoTarifaCombo_SelectionChanged">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Moto"/>
                            <ComboBoxItem Content="Camioneta"/>
                        </ComboBox>
                        <TextBlock x:Name="VersionTarifaText" Text=""/>
                        <TextBlock Text="Primera hora ($)"/>
                        <TextBox x:Name="PrimeraHoraInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Fracción adicional ($)"/>
                        <TextBox x:Name="FraccionPrecioInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Minutos por fracción"/>
                        <TextBox x:Name="MinutosFraccionInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Máximo por 24 horas ($)"/>
                        <TextBox x:Name="TopeDiaInput" Width="230" HorizontalAlignment="Left"/>
                        <TextBlock Text="Cortesía inicial en minutos"/>
                        <TextBox x:Name="CortesiaInput" Width="230" HorizontalAlignment="Left"/>
                        <Button Content="Guardar nueva versión de tarifa" Click="GuardarTarifa_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Por sector y horario">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="TARIFAS POR SECTOR Y FRANJA" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="Se aplica la franja del momento de ingreso a toda la estadía. Si no hay tarifa particular, se utiliza la general."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <ComboBox x:Name="TarifaSectorCombo" Width="320" HorizontalAlignment="Left"
                                  PlaceholderText="Elegir sector"
                                  SelectionChanged="TarifaSectorCombo_SelectionChanged"/>
                        <ComboBox x:Name="TarifaSectorTipoCombo" Width="220" SelectedIndex="0"
                                  HorizontalAlignment="Left" SelectionChanged="TarifaSectorCombo_SelectionChanged">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Moto"/>
                            <ComboBoxItem Content="Camioneta"/>
                        </ComboBox>
                        <ComboBox x:Name="TarifaFranjaCombo" Width="220" SelectedIndex="0"
                                  HorizontalAlignment="Left" SelectionChanged="TarifaSectorCombo_SelectionChanged">
                            <ComboBoxItem Content="Diurna" Tag="Diurna"/>
                            <ComboBoxItem Content="Nocturna" Tag="Nocturna"/>
                        </ComboBox>
                        <TextBlock Text="Horario nocturno del sector (HH:mm), por ejemplo 20:00 a 08:00"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="HorarioNocheInicioInput" Width="110" Text="20:00"/>
                            <TextBox x:Name="HorarioNocheFinInput" Width="110" Text="08:00"/>
                            <Button x:Name="GuardarHorarioButton" Content="Guardar horario"
                                    Click="GuardarHorario_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TarifaSectorVersionText" TextWrapping="Wrap"/>
                        <TextBlock Text="Primera hora ARS"/>
                        <TextBox x:Name="TarifaSectorPrimeraInput" Width="200" HorizontalAlignment="Left"/>
                        <TextBlock Text="Fracción adicional ARS"/>
                        <TextBox x:Name="TarifaSectorFraccionInput" Width="200" HorizontalAlignment="Left"/>
                        <TextBlock Text="Minutos por fracción"/>
                        <TextBox x:Name="TarifaSectorMinutosInput" Width="200" HorizontalAlignment="Left"/>
                        <TextBlock Text="Máximo por 24 horas ARS"/>
                        <TextBox x:Name="TarifaSectorTopeInput" Width="200" HorizontalAlignment="Left"/>
                        <TextBlock Text="Cortesía (minutos)"/>
                        <TextBox x:Name="TarifaSectorCortesiaInput" Width="200" HorizontalAlignment="Left"/>
