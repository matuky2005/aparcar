                        <TextBox x:Name="FiscalExentoInput" Width="230" HorizontalAlignment="Left"
                                 PlaceholderText="Exento"/>
                        <TextBox x:Name="FiscalNoGravadoInput" Width="230" HorizontalAlignment="Left"
